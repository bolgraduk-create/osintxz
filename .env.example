# ==========================================
# Application
# ==========================================

APP_NAME=Intelligence Platform

APP_VERSION=0.1.0

ENVIRONMENT=development

DEBUG=true

SECRET_KEY=CHANGE_THIS_SECRET_KEY

ACCESS_TOKEN_EXPIRE_MINUTES=1440



# ==========================================
# API
# ==========================================

HOST=0.0.0.0

PORT=8000



# ==========================================
# External Registry Credentials (optional)
# ==========================================

# OpenCorporates REST API token. Leave empty to keep the provider disabled.
OPENCORPORATES_API_TOKEN=

# CourtListener API v4 token. Leave empty to keep automatic execution blocked.
COURTLISTENER_API_TOKEN=

# ==========================================
# UK Companies House (optional)
# ==========================================

# Official Companies House Public Data API key.
COMPANIES_HOUSE_API_KEY=




# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_HOST=localhost

POSTGRES_PORT=5432

POSTGRES_DB=intelligence

POSTGRES_USER=intelligence

POSTGRES_PASSWORD=intelligence



# ==========================================
# Redis
# ==========================================

REDIS_HOST=localhost

REDIS_PORT=6379



# ==========================================
# Ollama
# ==========================================

OLLAMA_HOST=http://localhost:11434

DEFAULT_MODEL=llama3.1:8b



# ==========================================
# Storage
# ==========================================

STORAGE_PATH=storage

EXPORT_PATH=exports

CACHE_PATH=cache


# ==========================================
# Dark Web / Tor
# ==========================================
DARKWEB_TOR_SOCKS_PROXY=socks5h://127.0.0.1:9050
# OpenAlex free API key (recommended/required for production-scale API use)
OPENALEX_API_KEY=
# R13.10 Remote Adapter Pack 2
# SAM.gov public API key (free account key)
SAM_GOV_API_KEY=
# Trade.gov Data Services / CSL API key
TRADE_GOV_API_KEY=
# SEC requires an identifying User-Agent, e.g. OSINTXZ admin@example.com
SEC_EDGAR_USER_AGENT=
# R13.11 Remote Adapter Pack 3
# Australia ABN Lookup authentication GUID (free registration)
ABN_LOOKUP_GUID=
# Corporations Canada ISED API catalogue user-key (Public Plan)
CANADA_CORPORATIONS_API_KEY=
# Charity Commission England & Wales subscription key
UK_CHARITY_COMMISSION_API_KEY=
# Statistics Poland REGON BIR1.1 production user key
POLAND_REGON_API_KEY=
