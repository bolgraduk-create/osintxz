# ==========================================
# Application
# ==========================================

APP_NAME=Intelligence Platform

APP_VERSION=0.1.0

ENVIRONMENT=development

DEBUG=true

SECRET_KEY=CHANGE_THIS_SECRET_KEY

ACCESS_TOKEN_EXPIRE_MINUTES=1440



# ==========================================
# API
# ==========================================

HOST=0.0.0.0

PORT=8000



# ==========================================
# External Registry Credentials (optional)
# ==========================================

# OpenCorporates REST API token. Leave empty to keep the provider disabled.
OPENCORPORATES_API_TOKEN=

# CourtListener API v4 token. Leave empty to keep automatic execution blocked.
COURTLISTENER_API_TOKEN=

# ==========================================
# UK Companies House (optional)
# ==========================================

# Official Companies House Public Data API key.
COMPANIES_HOUSE_API_KEY=




# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_HOST=localhost

POSTGRES_PORT=5432

POSTGRES_DB=intelligence

POSTGRES_USER=intelligence

POSTGRES_PASSWORD=intelligence



# ==========================================
# Ordnance Survey Maps API (optional)
# ==========================================

# OS Data Hub API key. Enables Great Britain raster basemaps.
OS_MAPS_API_KEY=


# ==========================================
# Copernicus Data Space / Sentinel Hub (optional)
# ==========================================

# Public Sentinel-2 STAC discovery works without credentials.
# These two values enable bounded True Color rendering through Sentinel Hub.
# Create an OAuth client in the Copernicus Data Space Sentinel Hub dashboard.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=


# ==========================================
# Redis
# ==========================================

REDIS_HOST=localhost

REDIS_PORT=6379



# ==========================================
# AI Analysis
# ==========================================

# Explicit provider selection. Set to openai to use your OpenAI API key.
AI_PROVIDER=ollama

# OpenAI is used only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=120
# Keep false for investigation data unless you intentionally want API-side
# response retrieval/state.
OPENAI_STORE_RESPONSES=false


# ==========================================
# Ollama
# ==========================================

OLLAMA_HOST=http://localhost:11434

DEFAULT_MODEL=llama3.1:8b



# ==========================================
# Storage
# ==========================================

STORAGE_PATH=storage

EXPORT_PATH=exports

CACHE_PATH=cache


# ==========================================
# Dark Web / Tor
# ==========================================
DARKWEB_TOR_SOCKS_PROXY=socks5h://127.0.0.1:9050

# ==========================================
# R13.12 Exposure Intelligence (optional)
# ==========================================
# HIBP breached-account lookup requires an API subscription key.
HAVEIBEENPWNED_API_KEY=
# Intelligence X requires an API key/license for third-party integrations.
INTELLIGENCEX_API_KEY=
# Set this to the official API instance assigned to your IntelX account.
INTELLIGENCEX_API_URL=https://2.intelx.io

# R13.13 — optional authorized GitHub repository secret scanning.
# Fine-grained token needs Secret scanning alerts: read for the target repository.
GITHUB_SECRET_SCANNING_TOKEN=

# R13.15 — optional free/public-data keys. Leave blank to use anonymous/
# documented demo access; configure only if you want higher upstream quotas.
NVD_API_KEY=
OPENFDA_API_KEY=
FEC_API_KEY=
# OpenAlex free API key (recommended/required for production-scale API use)
OPENALEX_API_KEY=
# R13.10 Remote Adapter Pack 2
# SAM.gov public API key (free account key)
SAM_GOV_API_KEY=
# Trade.gov Data Services / CSL API key
TRADE_GOV_API_KEY=
# SEC requires an identifying User-Agent, e.g. OSINTXZ admin@example.com
SEC_EDGAR_USER_AGENT=
# R13.11 Remote Adapter Pack 3
# Australia ABN Lookup authentication GUID (free registration)
ABN_LOOKUP_GUID=
# Corporations Canada ISED API catalogue user-key (Public Plan)
CANADA_CORPORATIONS_API_KEY=
# Charity Commission England & Wales subscription key
UK_CHARITY_COMMISSION_API_KEY=
# Statistics Poland REGON BIR1.1 production user key
POLAND_REGON_API_KEY=
