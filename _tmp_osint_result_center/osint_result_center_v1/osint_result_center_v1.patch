+        if normalized == "partial":
+            return "#f4b638", "#3b3015"
+        if normalized in {"failed", "error"}:
+            return "#f25d68", "#3a1e26"
+        if normalized in {"not_available", "not_supported", "skipped"}:
+            return "#8094a8", "#1a2b37"
+        return "#68a4ff", "#142b47"
